{
  "modules": {
    "accessibility": {
      "enabled": true,
      "wcag": { "version": "2.2", "level": "AA" },
      "standard": "wcag"
    },
    "privacy": { "enabled": true },
    "cookies": { "enabled": true },
    "securityHeaders": { "enabled": false },
    "ssl": { "enabled": true },
    "brokenLinks": { "enabled": false }
  },
  "crawl": { "depth": 2, "maxPages": 10 },
  "output": {
    "formats": {
      "markdown": true,
      "html": true,
      "pdf": true,
      "json": true
    }
  },
  "suppress": [],
  "urls": [
    "https://nvco.github.io/site-audit-cli/"
  ]
}
