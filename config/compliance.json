{
  "wcag": {
    "version": "2.2",
    "level": "AA"
  },
  "modules": {
    "accessibility": true,
    "privacy": true,
    "cookies": true,
    "securityHeaders": false,
    "ssl": true,
    "brokenLinks": false
  },
  "crawl": {
    "depth": 2,
    "maxPages": 10
  },
  "brokenLinks": {
    "includeExternal": false
  },
  "output": {
    "formats": {
      "markdown": true,
      "html": true,
      "pdf": true,
      "json": true
    }
  },
  "suppress": [],
  "urls": [
    "https://nvco.github.io/site-audit-cli/"
  ]
}
