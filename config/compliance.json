{
  "modules": {
    "accessibility": {
      "enabled": true,
      "standard": "wcag",
      "wcag": {
        "version": "2.2",
        "level": "AA"
      }
    },
    "privacy": {
      "enabled": true,
      "consentBannerTimeout": 5000
    },
    "cookies": {
      "enabled": true
    },
    "securityHeaders": {
      "enabled": false
    },
    "ssl": {
      "enabled": true
    },
    "brokenLinks": {
      "enabled": false,
      "includeExternal": false,
      "ignoredStatusCodes": [401, 403]
    }
  },
  "output": {
    "formats": {
      "markdown": { "enabled": true, "showPagesAudited": true },
      "html":     { "enabled": true, "showPagesAudited": true },
      "pdf":      { "enabled": false, "showPagesAudited": false },
      "json":     { "enabled": true, "showPagesAudited": true }
    }
  },
  "showToolCredit": true,
  "compareLastRun": false,
  "maxIssuesPerRule": 5,
  "keepRunsForDays": 0,
  "suppress": [],
  "crawl": {
    "depth": 2,
    "maxPages": 10
  },
  "urls": [
    "https://nvco.github.io/site-audit-cli/"
  ]
}
