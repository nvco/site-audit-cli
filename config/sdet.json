{
  "modules": {
    "accessibility": {
      "enabled": false
    },
    "privacy": {
      "enabled": false
    },
    "cookies": {
      "enabled": true
    },
    "securityHeaders": {
      "enabled": true
    },
    "ssl": {
      "enabled": true
    },
    "brokenLinks": {
      "enabled": true,
      "includeExternal": false,
      "ignoredStatusCodes": [401, 403]
    }
  },
  "output": {
    "formats": {
      "markdown": { "enabled": true, "showPagesAudited": true },
      "html":     { "enabled": false, "showPagesAudited": true },
      "pdf":      { "enabled": false, "showPagesAudited": false },
      "json":     { "enabled": true, "showPagesAudited": true }
    }
  },
  "showToolCredit": true,
  "compareLastRun": false,
  "maxIssuesPerRule": 5,
  "keepRunsForDays": 0,
  "suppress": [],
  "crawl": {
    "depth": 2,
    "maxPages": 10
  },
  "urls": [
    "https://nvco.github.io/site-audit-cli/"
  ]
}
