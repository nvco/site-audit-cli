{
  "modules": {
    "accessibility": {
      "enabled": true,
      "standard": "wcag",
      "wcag": {
        "version": "2.2",
        "level": "AA"
      }
    },
    "privacy": {
      "enabled": true
    },
    "cookies": {
      "enabled": true
    },
    "securityHeaders": {
      "enabled": true
    },
    "ssl": {
      "enabled": true
    },
    "brokenLinks": {
      "enabled": true,
      "includeExternal": false
    }
  },
  "output": {
    "formats": {
      "markdown": true,
      "html": true,
      "pdf": true,
      "json": true
    }
  },
  "compareLastRun": false,
  "suppress": [],
  "crawl": {
    "depth": 2,
    "maxPages": 10
  },
  "urls": [
    "https://nvco.github.io/site-audit-cli/"
  ]
}
